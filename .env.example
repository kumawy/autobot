NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://musicbox:musicbox@127.0.0.1:55432/musicbox
# Migrations use DIRECT_URL when set; Supabase: session pooler port 5432, runtime port 6543.
DIRECT_URL=
# demo = local transport (offline defaults); staging = real Meta/OpenAI + mock; live = integrations.
INTEGRATION_MODE=demo
# Independent AI selection: empty follows mode; openai also works with local demo transport.
AI_PROVIDER=
# Empty uses mode default: enabled only in demo. Always absent in production/staging.
DEV_ROUTES_ENABLED=
PAYMENT_PROVIDER=mock
# Local examples only. npm run demo generates a private .env with random secrets.
ADMIN_TOKEN=local-change-this-token-before-deployment
MOCK_PAYMENT_SECRET=local-change-this-mock-secret-before-deployment
# cloud = existing Meta API; baileys = QR linking (staging/live).
WHATSAPP_TRANSPORT=cloud
# Experimental native quick-reply buttons for Baileys. Cloud is unaffected.
WHATSAPP_BAILEYS_BUTTONS=false
WHATSAPP_SESSION_ID=primary
# Baileys: 32 random bytes in hex. Keep stable across deploys; credentials are encrypted in DB.
WHATSAPP_AUTH_ENCRYPTION_KEY=
# International digits without +; reject pairing a different account.
WHATSAPP_EXPECTED_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=
# JSON registry of actual approved names/locales. Empty means outside-window sends are blocked.
WHATSAPP_TEMPLATE_REGISTRY={}
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_TOOL_CALLS=4
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_BASE_URL=https://api.freedompay.kz
FREEDOMPAY_TEST_MODE=true
GOOGLE_SHEETS_SPREADSHEET_ID=
# Empty follows mode; google selects the real API even with INTEGRATION_MODE=demo.
GOOGLE_SHEETS_PROVIDER=
# Empty: demo/live enabled, staging disabled. Explicit false disables export without losing orders.
GOOGLE_SHEETS_ENABLED=
GOOGLE_SHEETS_RANGE=Orders!A:Y
# Enable only after npm run sheets:setup -- --shipping has added Z:AB.
GOOGLE_SHEETS_SHIPPING_ENABLED=false
GOOGLE_SHEETS_SHEET_ID=0
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Prefer a private ignored JSON file over a multiline secret in env.
GOOGLE_APPLICATION_CREDENTIALS=
# Owner of the spreadsheet, used by sheets:setup when protecting the Orders tab.
GOOGLE_SHEETS_OWNER_EMAIL=
TELEGRAM_BOT_TOKEN=
# Empty: demo simulated; staging disabled; live enabled only when a bot token is configured.
TELEGRAM_ENABLED=
# Empty follows TELEGRAM_ENABLED. false gives a controlled customer fallback.
MANAGER_HANDOFF_ENABLED=
TELEGRAM_MANAGER_CHAT_ID=
# Preferred name; TELEGRAM_ALLOWED_MANAGER_IDS remains a backward-compatible alias.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_MANAGER_IDS=
TELEGRAM_WEBHOOK_SECRET=
PRODUCT_PRICE_KZT=20000
MAX_ORDER_QUANTITY=10
PROCESS_FIRST_MESSAGE_AFTER_LANGUAGE=true
WORKER_INTERVAL_MS=1000
MAX_RETRY_ATTEMPTS=8
BUSINESS_NAME=Music Box Demo
BUSINESS_PHONE=
MANAGER_NAME=
LOG_LEVEL=info

# Enable only after the owner approves retention periods. Financial dedupe keys are retained.
RETENTION_APPROVED=false
MESSAGE_RETENTION_DAYS=90
WEBHOOK_RETENTION_DAYS=30

WHATSAPP_WINDOW_SAFETY_SECONDS=60
PAYMENT_RECONCILE_INTERVAL_MS=300000
PAYMENT_RECONCILE_BATCH_SIZE=100
PAYMENT_PROVIDER_MIN_INTERVAL_MS=2000
