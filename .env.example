NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://musicbox:musicbox@127.0.0.1:55432/musicbox
INTEGRATION_MODE=demo
PAYMENT_PROVIDER=mock
# Local examples only. npm run demo generates a private .env with random secrets.
ADMIN_TOKEN=local-change-this-token-before-deployment
MOCK_PAYMENT_SECRET=local-change-this-mock-secret-before-deployment
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=
# JSON registry of actual approved names/locales. Empty means outside-window sends are blocked.
WHATSAPP_TEMPLATE_REGISTRY={}
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_TOOL_CALLS=4
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_BASE_URL=https://api.freedompay.kz
FREEDOMPAY_TEST_MODE=true
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Orders!A:Y
GOOGLE_SHEETS_SHEET_ID=0
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_ALLOWED_MANAGER_IDS=
TELEGRAM_WEBHOOK_SECRET=
PRODUCT_PRICE_KZT=20000
MAX_ORDER_QUANTITY=10
PROCESS_FIRST_MESSAGE_AFTER_LANGUAGE=true
WORKER_INTERVAL_MS=1000
MAX_RETRY_ATTEMPTS=8
BUSINESS_NAME=Music Box Demo
BUSINESS_PHONE=
MANAGER_NAME=
LOG_LEVEL=info

# Enable only after the owner approves retention periods. Financial dedupe keys are retained.
RETENTION_APPROVED=false
MESSAGE_RETENTION_DAYS=90
WEBHOOK_RETENTION_DAYS=30

WHATSAPP_WINDOW_SAFETY_SECONDS=60
PAYMENT_RECONCILE_INTERVAL_MS=300000
PAYMENT_RECONCILE_BATCH_SIZE=100
PAYMENT_PROVIDER_MIN_INTERVAL_MS=2000
