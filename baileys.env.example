# Copy to .env.baileys.local (ignored), fill private values. See docs/BAILEYS_RAILWAY.md.
NODE_ENV=development
INTEGRATION_MODE=staging
WHATSAPP_TRANSPORT=baileys
# Enable only after checking button rendering on your WhatsApp client.
WHATSAPP_BAILEYS_BUTTONS=false
WHATSAPP_SESSION_ID=primary
WHATSAPP_EXPECTED_NUMBER=
WHATSAPP_AUTH_ENCRYPTION_KEY=
HOST=0.0.0.0
APP_BASE_URL=https://YOUR-SERVICE.up.railway.app
DATABASE_URL=
DIRECT_URL=
ADMIN_TOKEN=
MOCK_PAYMENT_SECRET=
DEV_ROUTES_ENABLED=false
PAYMENT_PROVIDER=mock
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SHIPPING_ENABLED=false
TELEGRAM_ENABLED=false
MANAGER_HANDOFF_ENABLED=false
LOG_LEVEL=info
